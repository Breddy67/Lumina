config {
  width = 800
  height = 600
  mode = interactive
  title = "Bouncing Ball"
}

let px = 20
let py = 300
let vx = 10
let vy = 6
let r = 20

loop {
  clear()
  vy = vy + 0.6
  px = px + vx
  py = py + vy

  if (py + r > 600) {
      py = 600 - r
      vy = vy * -1
  }

  if (px + r > 800) {
      px = 800 - r
      vx = vx * -1
  } else if (px - r < 0) {
      px = r
      vx = vx * -1
  }

  draw Circle((px, py), r, color=#00ff00)
}