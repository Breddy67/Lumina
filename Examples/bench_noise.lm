config {
  width = 200
  height = 200
}

let scale = 0.02
let step = 2

loop {
  clear()
  for y in range(0, height / step) {
    for x in range(0, width / step) {
      let px = x * step
      let py = y * step
      let n = noise2(px * scale, py * scale)
      
      // Color based on noise value
      if (n < -0.5) {
        draw Rect((px, py), step, step, color = #0000ff)
      } else if (n < -0.2) {
        draw Rect((px, py), step, step, color = #0088ff)
      } else if (n < 0) {
        draw Rect((px, py), step, step, color = #00ff88)
      } else if (n < 0.2) {
        draw Rect((px, py), step, step, color = #00ff00)
      } else if (n < 0.5) {
        draw Rect((px, py), step, step, color = #ff8800)
      } else {
        draw Rect((px, py), step, step, color = #ff0000)
      }
    }
  }
}